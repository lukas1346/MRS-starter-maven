<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox prefHeight="220.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mrs.GUI.Controller.SignUpViewController">
   <children>
      <Label text="Username" />
      <TextField fx:id="txtUsername" />
      <Label text="Password" />
      <TextField fx:id="txtPassword" />
      <Label text="Verify Password" />
      <TextField fx:id="txtVerifyPassword" />
      <HBox alignment="CENTER" prefHeight="65.0" prefWidth="289.0">
         <children>
            <Button mnemonicParsing="false" onAction="#backClicked" text="Back" />
            <Button mnemonicParsing="false" onAction="#signUpClicked" text="Sign Up">
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <Label fx:id="lblIncorrect" text="Label" />
   </children>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</VBox>
