<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mrs.GUI.Controller.MovieViewController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0">
         <children>
            <VBox prefHeight="50.0" prefWidth="400.0">
               <children>
                  <Label text="Movie Title" />
                  <TextField fx:id="txtTitle" prefWidth="200.0" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#createMovie" text="Create" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0">
         <children>
            <VBox prefHeight="58.0" prefWidth="250.0">
               <children>
                  <Label text="Year" />
                  <TextField fx:id="txtYear" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#updateMovie" text="Update" />
            <Button mnemonicParsing="false" onAction="#deleteMovie" text="Delete" />
         </children>
      </HBox>
      <TextField fx:id="txtMovieSearch" promptText="Search" />
      <TableView fx:id="tblMovies" prefHeight="1000.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="50.0" text="Id" />
          <TableColumn fx:id="colTitle" prefWidth="500.0" text="Title" />
            <TableColumn fx:id="colYear" prefWidth="50.0" text="Year" />
        </columns>
      </TableView>
   </children>
</VBox>
