<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mrs.GUI.Controller.RatingViewController">
   <children>
      <Label fx:id="lblSelectedMovie" text="Selected Movie: " />
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <VBox prefHeight="100.0" prefWidth="700.0">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <VBox prefHeight="92.0" prefWidth="400.0">
                           <children>
                              <Label text="Username" />
                              <TextField fx:id="txtUser" maxWidth="300.0" prefHeight="25.0" prefWidth="300.0" />
                              <Label fx:id="lblRating" text="Rating: " />
                              <Slider fx:id="sliderRating" maxWidth="300.0" prefWidth="300.0" />
                              <Label text="Review" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#createRating" text="Add Rating" />
                              <Button mnemonicParsing="false" onAction="#deleteRating" text="Delete Rating" />
                              <Button mnemonicParsing="false" onAction="#updateRating" text="Update Rating" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <TextField fx:id="txtReview" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" />
         </children>
      </HBox>
      <TableView fx:id="tblRatings" prefHeight="731.0" prefWidth="800.0">
        <columns>
          <TableColumn fx:id="colUser" prefWidth="200.0" text="User" />
          <TableColumn fx:id="colRating" minWidth="100.0" prefWidth="100.0" text="Rating" />
            <TableColumn fx:id="colReview" prefWidth="500.0" text="Review" />
        </columns>
      </TableView>
   </children>
</VBox>
